# Copy to .env and fill in real values. Never commit .env.
# All services read configuration from environment variables only.
#
# Who reads this file:
# - docker compose: substitutes these values into docker-compose.yml; only the
#   variables named there reach the containers.
# - the backend run natively (uvicorn, app.worker, app.cli): reads this file.
# - the frontend run natively (npm run dev / start): does NOT read it; Next.js
#   reads its own environment (shell or frontend/.env.local).
# Commented lines are optional and show the built-in default; leave them
# commented unless you need a different value.

# --- Runtime ---------------------------------------------------------------
# development | test | production
APP_ENV=development
LOG_LEVEL=INFO

# --- PostgreSQL --------------------------------------------------------------
# Use a strong, URL-safe password (letters, digits, - and _), since it is
# interpolated into DATABASE_URL below.
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=change-me-to-a-long-random-value
POSTGRES_DB=sentinel_vapt

# Used by the backend when running OUTSIDE Docker (local venv). Use 127.0.0.1,
# not localhost: on Windows localhost resolves to IPv6 ::1 first, and compose
# publishes Postgres on IPv4 127.0.0.1 only, which adds a ~15s delay per connection.
# Inside docker compose, DATABASE_URL is built from the POSTGRES_* values above.
DATABASE_URL=postgresql+psycopg://sentinel:change-me-to-a-long-random-value@127.0.0.1:5432/sentinel_vapt

# --- Backend API -----------------------------------------------------------
# Comma-separated list of origins allowed to call the API from a browser. The
# operator console calls the API from its server, never from the browser.
CORS_ORIGINS=http://localhost:3000

# Optional tuning, read by the backend run natively (docker compose does not
# pass these to the containers). Values outside the bounds are refused at start.
# Sessions: idle minutes (5-120), absolute hours (1-24).
# AUTH_SESSION_IDLE_MINUTES=30
# AUTH_SESSION_ABSOLUTE_HOURS=12
# Argon2id: time cost (2-10), memory KiB (19456-1048576), parallelism (1-16).
# AUTH_ARGON2_TIME_COST=3
# AUTH_ARGON2_MEMORY_KIB=65536
# AUTH_ARGON2_PARALLELISM=4
# Login throttling: window seconds (up to 86400); per account: failures before
# delays (1-100), base delay (up to 60 s), maximum delay (up to 3600 s);
# per source address: failures in the window (1-100000).
# AUTH_THROTTLE_WINDOW_SECONDS=900
# AUTH_THROTTLE_ACCOUNT_THRESHOLD=5
# AUTH_THROTTLE_ACCOUNT_BASE_DELAY_SECONDS=1
# AUTH_THROTTLE_ACCOUNT_MAX_DELAY_SECONDS=900
# AUTH_THROTTLE_SOURCE_THRESHOLD=50
# Workers (python -m app.worker): id (default host:pid), role
# (scans | reports | all), poll / heartbeat seconds (up to 60), stale scan
# seconds (up to 3600), stale report seconds (up to 86400).
# WORKER_ID=
# WORKER_ROLE=all
# WORKER_POLL_SECONDS=2
# WORKER_HEARTBEAT_SECONDS=5
# WORKER_STALE_AFTER_SECONDS=60
# WORKER_REPORT_STALE_AFTER_SECONDS=600

# --- Frontend (Next.js server) ---------------------------------------------
# Next.js does not read this file: when running the frontend natively, set
# these in the shell or in frontend/.env.local. docker compose sets
# API_INTERNAL_URL for the frontend container itself (http://backend:8000).
# URL the Next.js server uses to reach the API.
API_INTERNAL_URL=http://localhost:8000
# Host header values the console accepts (comma-separated host:port). Default:
# localhost:3000,127.0.0.1:3000.
# FRONTEND_ALLOWED_HOSTS=localhost:3000,127.0.0.1:3000
# Development server only: 1 drops the Secure flag and __Host- prefix of the
# session cookie, for a browser that refuses Secure cookies over plain HTTP.
# Ignored in production builds. Leave unset unless you need it.
# SESSION_COOKIE_INSECURE=1

# --- Tests only (not runtime configuration) --------------------------------
# Backend integration tests: database URL (default: DATABASE_URL's database
# name plus _test). REQUIRE_PDF=1 makes missing WeasyPrint libraries an error.
# TEST_DATABASE_URL=
# REQUIRE_PDF=1
# Playwright (frontend/tests/e2e; see docs/frontend.md). E2E_BASE_URL turns on
# the live-stack specs, which write test accounts and data into the running
# stack's database. The admin credentials are only needed once an
# administrator exists; never put real credentials in a committed file.
# E2E_BASE_URL=http://localhost:3000
# E2E_API_URL=http://127.0.0.1:8000
# E2E_ADMIN_USERNAME=
# E2E_ADMIN_PASSWORD=
# E2E_COMPOSE_NETWORK=sentinel-vapt_default
# E2E_LAB_RETEST=1
