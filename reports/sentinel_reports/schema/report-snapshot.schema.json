{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sentinelvapt:report-snapshot:1",
  "title": "SentinelVAPT report snapshot (sentinelvapt.report/1)",
  "description": "Immutable input of a report: everything a renderer may show, frozen when the report is requested. Built by the backend from persisted, redacted data only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document",
    "inputs",
    "engagement",
    "scope",
    "methodology",
    "scan",
    "taxonomy_editions",
    "issues",
    "evidence",
    "timeline"
  ],
  "properties": {
    "schema_version": { "const": "sentinelvapt.report/1" },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "report_id",
        "number",
        "title",
        "kind",
        "classification",
        "prepared_by",
        "reviewed_by",
        "created_at",
        "template"
      ],
      "properties": {
        "report_id": { "$ref": "#/$defs/uuid" },
        "number": { "type": "string", "pattern": "^SV-R-[0-9]{6,12}$" },
        "title": { "$ref": "#/$defs/name" },
        "kind": { "enum": ["draft", "final"] },
        "classification": { "enum": ["internal", "confidential", "restricted"] },
        "prepared_by": { "$ref": "#/$defs/name" },
        "reviewed_by": { "$ref": "#/$defs/optional_name" },
        "created_at": { "$ref": "#/$defs/datetime" },
        "template": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version"],
          "properties": {
            "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
            "version": { "type": "integer", "minimum": 1, "maximum": 10000 }
          }
        }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executive_summary_note", "scope_note"],
      "properties": {
        "executive_summary_note": { "$ref": "#/$defs/optional_note" },
        "scope_note": { "$ref": "#/$defs/optional_note" }
      }
    },
    "engagement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "target", "assessment", "authorization"],
      "properties": {
        "project": { "$ref": "#/$defs/named" },
        "target": { "$ref": "#/$defs/named" },
        "assessment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "name", "description", "status", "started_at", "completed_at"],
          "properties": {
            "id": { "$ref": "#/$defs/uuid" },
            "name": { "$ref": "#/$defs/name" },
            "description": {
              "oneOf": [{ "type": "null" }, { "type": "string", "maxLength": 5000 }]
            },
            "status": { "enum": ["planned", "in_progress", "completed", "cancelled"] },
            "started_at": { "$ref": "#/$defs/optional_datetime" },
            "completed_at": { "$ref": "#/$defs/optional_datetime" }
          }
        },
        "authorization": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version",
            "authorized_by",
            "reference",
            "valid_from",
            "valid_until",
            "acknowledged_by",
            "acknowledged_at"
          ],
          "properties": {
            "id": { "$ref": "#/$defs/uuid" },
            "version": { "type": "integer", "minimum": 1 },
            "authorized_by": { "$ref": "#/$defs/name" },
            "reference": { "$ref": "#/$defs/name" },
            "valid_from": { "$ref": "#/$defs/datetime" },
            "valid_until": { "$ref": "#/$defs/datetime" },
            "acknowledged_by": { "$ref": "#/$defs/name" },
            "acknowledged_at": { "$ref": "#/$defs/datetime" }
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_url",
        "environment",
        "in_scope_hosts",
        "allowed_ports",
        "in_scope_path_prefixes",
        "excluded_paths"
      ],
      "properties": {
        "base_url": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "environment": { "type": "string", "maxLength": 32 },
        "in_scope_hosts": {
          "type": "array",
          "maxItems": 256,
          "items": { "type": "string", "maxLength": 255 }
        },
        "allowed_ports": {
          "type": "array",
          "maxItems": 256,
          "items": { "type": "integer", "minimum": 1, "maximum": 65535 }
        },
        "in_scope_path_prefixes": { "$ref": "#/$defs/paths" },
        "excluded_paths": { "$ref": "#/$defs/paths" }
      }
    },
    "methodology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scanner_version",
        "verify_tls",
        "limits",
        "crawl",
        "ruleset_version",
        "analysis_run_id",
        "analysis_finished_at",
        "rules_evaluated",
        "rules_available",
        "rules"
      ],
      "properties": {
        "scanner_version": {
          "oneOf": [{ "type": "null" }, { "type": "string", "maxLength": 32 }]
        },
        "verify_tls": { "type": "boolean" },
        "limits": { "$ref": "#/$defs/settings" },
        "crawl": { "$ref": "#/$defs/settings" },
        "ruleset_version": { "type": "string", "pattern": "^rs-[0-9a-f]{16}$" },
        "analysis_run_id": { "$ref": "#/$defs/uuid" },
        "analysis_finished_at": { "$ref": "#/$defs/datetime" },
        "rules_evaluated": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "rules_available": { "type": "boolean" },
        "rules": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "version", "title", "category", "severity", "detection_type", "wstg"],
            "properties": {
              "id": { "$ref": "#/$defs/rule_id" },
              "version": { "type": "integer", "minimum": 1 },
              "title": { "$ref": "#/$defs/text" },
              "category": { "$ref": "#/$defs/token" },
              "severity": { "$ref": "#/$defs/severity" },
              "detection_type": { "$ref": "#/$defs/detection_type" },
              "wstg": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/wstg_id" } }
            }
          }
        }
      }
    },
    "scan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "stop_reason",
        "started_at",
        "finished_at",
        "requests_sent",
        "pages_count",
        "endpoints_count",
        "events_count",
        "evidence_count",
        "coverage_notes",
        "rule_errors"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "status": { "const": "completed" },
        "stop_reason": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/token" }] },
        "started_at": { "$ref": "#/$defs/datetime" },
        "finished_at": { "$ref": "#/$defs/datetime" },
        "requests_sent": { "$ref": "#/$defs/count" },
        "pages_count": { "$ref": "#/$defs/count" },
        "endpoints_count": { "$ref": "#/$defs/count" },
        "events_count": { "$ref": "#/$defs/count" },
        "evidence_count": { "$ref": "#/$defs/count" },
        "coverage_notes": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/token" } },
        "rule_errors": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["rule_id", "error"],
            "properties": {
              "rule_id": { "$ref": "#/$defs/rule_id" },
              "error": { "type": "string", "maxLength": 128 }
            }
          }
        }
      }
    },
    "taxonomy_editions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owasp_top10", "wstg", "cwe"],
      "properties": {
        "owasp_top10": { "$ref": "#/$defs/name" },
        "wstg": { "$ref": "#/$defs/name" },
        "cwe": { "$ref": "#/$defs/name" }
      }
    },
    "issues": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/issue" } },
    "evidence": { "type": "array", "maxItems": 5000, "items": { "$ref": "#/$defs/evidence" } },
    "timeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entries", "truncated"],
      "properties": {
        "truncated": { "type": "boolean" },
        "entries": {
          "type": "array",
          "maxItems": 2000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["at", "kind", "detail"],
            "properties": {
              "at": { "$ref": "#/$defs/datetime" },
              "kind": {
                "enum": [
                  "authorization_acknowledged",
                  "assessment_started",
                  "assessment_completed",
                  "scan_started",
                  "scan_finished",
                  "analysis_completed",
                  "finding_triaged",
                  "report_requested"
                ]
              },
              "detail": { "type": "string", "maxLength": 600 }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "datetime": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?\\+00:00$"
    },
    "optional_datetime": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/datetime" }] },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "optional_name": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/name" }] },
    "optional_note": { "oneOf": [{ "type": "null" }, { "type": "string", "maxLength": 4000 }] },
    "text": { "type": "string", "maxLength": 4000 },
    "token": { "type": "string", "pattern": "^[a-z0-9_]{1,64}$" },
    "count": { "type": "integer", "minimum": 0 },
    "named": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": { "id": { "$ref": "#/$defs/uuid" }, "name": { "$ref": "#/$defs/name" } }
    },
    "paths": {
      "type": "array",
      "maxItems": 256,
      "items": { "type": "string", "maxLength": 2048 }
    },
    "settings": {
      "type": "object",
      "maxProperties": 50,
      "propertyNames": { "pattern": "^[a-z0-9_]{1,64}$" },
      "additionalProperties": {
        "oneOf": [
          { "type": "null" },
          { "type": "boolean" },
          { "type": "number" },
          { "type": "string", "maxLength": 200 },
          {
            "type": "array",
            "maxItems": 50,
            "items": { "type": ["string", "number", "boolean"], "maxLength": 200 }
          }
        ]
      }
    },
    "rule_id": { "type": "string", "pattern": "^SV-[A-Z]{3}-[0-9]{3}$" },
    "wstg_id": { "type": "string", "pattern": "^WSTG-[A-Z]{4}-[0-9]{2}$" },
    "severity": { "enum": ["critical", "high", "medium", "low", "informational"] },
    "confidence": { "enum": ["high", "medium", "low"] },
    "detection_type": { "enum": ["automated_detection", "manual_verification_required"] },
    "finding_status": { "enum": ["open", "confirmed", "false_positive", "accepted_risk"] },
    "https_url": { "type": "string", "pattern": "^https://", "maxLength": 2048 },
    "optional_https_url": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/https_url" }] },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule", "instances"],
      "properties": {
        "rule": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version",
            "title",
            "category",
            "severity",
            "confidence",
            "detection_type",
            "subject_type",
            "description",
            "proves",
            "does_not_prove",
            "remediation",
            "owasp_top10",
            "wstg",
            "cwe",
            "references"
          ],
          "properties": {
            "id": { "$ref": "#/$defs/rule_id" },
            "version": { "type": "integer", "minimum": 1 },
            "title": { "$ref": "#/$defs/text" },
            "category": { "$ref": "#/$defs/token" },
            "severity": { "$ref": "#/$defs/severity" },
            "confidence": { "$ref": "#/$defs/confidence" },
            "detection_type": { "$ref": "#/$defs/detection_type" },
            "subject_type": { "enum": ["origin", "endpoint"] },
            "description": { "$ref": "#/$defs/text" },
            "proves": { "$ref": "#/$defs/text" },
            "does_not_prove": { "$ref": "#/$defs/text" },
            "remediation": { "$ref": "#/$defs/text" },
            "owasp_top10": {
              "type": "array",
              "maxItems": 10,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "title"],
                "properties": {
                  "id": { "type": "string", "pattern": "^A[0-9]{2}:2025$" },
                  "title": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/name" }] }
                }
              }
            },
            "wstg": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "title", "url"],
                "properties": {
                  "id": { "$ref": "#/$defs/wstg_id" },
                  "title": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/name" }] },
                  "url": { "$ref": "#/$defs/optional_https_url" }
                }
              }
            },
            "cwe": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "title", "url"],
                "properties": {
                  "id": { "type": "integer", "minimum": 1, "maximum": 100000 },
                  "title": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/name" }] },
                  "url": { "$ref": "#/$defs/optional_https_url" }
                }
              }
            },
            "references": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/https_url" } }
          }
        },
        "instances": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/instance" }
        }
      }
    },
    "instance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "fingerprint",
        "subject_type",
        "subject_key",
        "discriminator",
        "severity",
        "confidence",
        "detection_type",
        "details",
        "affected_count",
        "status",
        "status_reason",
        "status_changed_by",
        "status_changed_at",
        "evidence_ids"
      ],
      "properties": {
        "finding_id": { "$ref": "#/$defs/uuid" },
        "fingerprint": { "$ref": "#/$defs/sha256" },
        "subject_type": { "enum": ["origin", "endpoint"] },
        "subject_key": { "type": "string", "minLength": 1, "maxLength": 2200 },
        "discriminator": { "type": "string", "maxLength": 255 },
        "severity": { "$ref": "#/$defs/severity" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "detection_type": { "$ref": "#/$defs/detection_type" },
        "details": {
          "type": "object",
          "maxProperties": 10,
          "propertyNames": { "maxLength": 64 },
          "additionalProperties": {
            "oneOf": [
              { "type": "null" },
              { "type": "boolean" },
              { "type": "integer" },
              { "type": "string", "maxLength": 300 }
            ]
          }
        },
        "affected_count": { "type": "integer", "minimum": 1 },
        "status": { "$ref": "#/$defs/finding_status" },
        "status_reason": {
          "oneOf": [{ "type": "null" }, { "type": "string", "maxLength": 2000 }]
        },
        "status_changed_by": { "$ref": "#/$defs/optional_name" },
        "status_changed_at": { "$ref": "#/$defs/optional_datetime" },
        "evidence_ids": {
          "type": "array",
          "maxItems": 25,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/uuid" }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "method",
        "url",
        "status_code",
        "peer",
        "body_sha256",
        "body_sha256_label",
        "body_bytes_captured",
        "truncated",
        "headers",
        "headers_truncated",
        "excerpt",
        "excerpt_truncated"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "method": { "type": "string", "pattern": "^[A-Z]{1,16}$" },
        "url": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "status_code": { "type": "integer", "minimum": 0, "maximum": 999 },
        "peer": { "type": "string", "maxLength": 45 },
        "body_sha256": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }] },
        "body_sha256_label": { "const": "SHA-256 of the unredacted captured response bytes." },
        "body_bytes_captured": { "$ref": "#/$defs/count" },
        "truncated": { "type": "boolean" },
        "headers": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "array",
            "prefixItems": [
              { "type": "string", "maxLength": 128 },
              { "type": "string", "maxLength": 1024 }
            ],
            "minItems": 2,
            "maxItems": 2
          }
        },
        "headers_truncated": { "type": "boolean" },
        "excerpt": { "oneOf": [{ "type": "null" }, { "type": "string", "maxLength": 1024 }] },
        "excerpt_truncated": { "type": "boolean" }
      }
    }
  }
}
