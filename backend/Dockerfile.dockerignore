# Applies to builds of backend/Dockerfile, whose context is the repository root.
# Allowlist: only the backend, scanner and analysis sources are sent to the builder.
*
!backend/pyproject.toml
!backend/alembic.ini
!backend/alembic/
!backend/app/
!scanner/pyproject.toml
!scanner/sentinel_scanner/
!analysis/pyproject.toml
!analysis/sentinel_analysis/

**/__pycache__
**/*.pyc
**/*.egg-info
**/.mypy_cache
**/.pytest_cache
**/.ruff_cache
