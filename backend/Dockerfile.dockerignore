# Applies to builds of backend/Dockerfile, whose context is the repository root.
# Allowlist: only the backend, scanner, analysis and reports sources are sent to
# the builder.
*
!backend/pyproject.toml
!backend/alembic.ini
!backend/alembic/
!backend/app/
!scanner/pyproject.toml
!scanner/sentinel_scanner/
!analysis/pyproject.toml
!analysis/sentinel_analysis/
!reports/pyproject.toml
!reports/sentinel_reports/

**/__pycache__
**/*.pyc
**/*.egg-info
**/.mypy_cache
**/.pytest_cache
**/.ruff_cache
